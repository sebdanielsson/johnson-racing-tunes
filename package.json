{
  "name": "johnson-racing-tunes",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, browsable frontend for Johnson Racing Tunes — Forza car tune share codes across every game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:fresh": "node scripts/fetch-data.mjs && vite build",
    "fetch-data": "node scripts/fetch-data.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "ui": "shadcn"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "csv-parse": "^7.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.21.0"
}
